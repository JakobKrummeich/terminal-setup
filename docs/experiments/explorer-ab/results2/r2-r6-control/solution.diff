diff --git a/frontend/src/app/presenter/useSessionName.ts b/frontend/src/app/presenter/useSessionName.ts
new file mode 100644
index 0000000..c65957a
--- /dev/null
+++ b/frontend/src/app/presenter/useSessionName.ts
@@ -0,0 +1,22 @@
+"use client";
+
+import { useEffect, useState } from "react";
+import type { PresenterSessionStatePort } from "../../domain/ports/presenter/sessionStatePort";
+
+export function useSessionName(
+  sessionState: PresenterSessionStatePort,
+): string | null {
+  const [sessionName, setSessionName] = useState<string | null>(null);
+
+  useEffect(() => {
+    const subscription = sessionState.workshopState.subscribe((state) => {
+      setSessionName(state.sessionName);
+    });
+
+    return () => {
+      subscription.unsubscribe();
+    };
+  }, [sessionState]);
+
+  return sessionName;
+}
