+import { renderHook, act } from "@testing-library/react";
+import type { ReactNode } from "react";
+import { Subject } from "rxjs";
+import { ConnectionState } from "../../../../../domain/connectionState";
+import { Phase } from "../../../../../domain/phases";
+import type { ParticipantWorkshopState } from "../../../../../domain/workshopState";
+import { ParticipantDependencyProvider } from "../../../dependencies";
+import { useJoinLobby } from "../useJoinLobby";
+
+function fakeSession() {
+  const workshopState = new Subject<ParticipantWorkshopState>();
+  const connectionState = new Subject<ConnectionState>();
+  const wrapper = ({ children }: { children: ReactNode }) => (
+    <ParticipantDependencyProvider
+      dependencies={{ sessionState: { workshopState, connectionState } }}
+    >
+      {children}
+    </ParticipantDependencyProvider>
+  );
+
+  return { wrapper, workshopState, connectionState };
+}
+
+function joinState(participantCount: number): ParticipantWorkshopState {
+  return { revision: 1, phase: Phase.Join, participantCount };
+}
+
+describe("join lobby logic", () => {
+  it("starts disconnected and without a count", () => {
+    const { wrapper } = fakeSession();
+
+    const { result } = renderHook(() => useJoinLobby(), { wrapper });
+
+    expect(result.current).toEqual({
+      isConnected: false,
+      participantCountLabel: null,
+    });
+  });
+
+  it("counts itself as connected only once the connection is established", () => {
+    const { wrapper, connectionState } = fakeSession();
+    const { result } = renderHook(() => useJoinLobby(), { wrapper });
+
+    act(() => connectionState.next(ConnectionState.Connected));
+    expect(result.current.isConnected).toBe(true);
+
+    act(() => connectionState.next(ConnectionState.Reconnecting));
+    expect(result.current.isConnected).toBe(false);
+  });
+
+  it("follows the participant count the server pushes", () => {
+    const { wrapper, workshopState } = fakeSession();
+    const { result } = renderHook(() => useJoinLobby(), { wrapper });
+
+    act(() => workshopState.next(joinState(3)));
+    expect(result.current.participantCountLabel).toBe("3 participants");
+
+    act(() => workshopState.next(joinState(7)));
+    expect(result.current.participantCountLabel).toBe("7 participants");
+  });
+
+  it("keeps the count readable for a lone participant", () => {
+    const { wrapper, workshopState } = fakeSession();
+    const { result } = renderHook(() => useJoinLobby(), { wrapper });
+
+    act(() => workshopState.next(joinState(1)));
+
+    expect(result.current.participantCountLabel).toBe("1 participant");
+  });
+
+  it("shows an empty lobby as zero participants", () => {
+    const { wrapper, workshopState } = fakeSession();
+    const { result } = renderHook(() => useJoinLobby(), { wrapper });
+
+    act(() => workshopState.next(joinState(0)));
+
+    expect(result.current.participantCountLabel).toBe("0 participants");
+  });
+
+  it("stops listening when the screen is left", () => {
+    const { wrapper, workshopState, connectionState } = fakeSession();
+    const { unmount } = renderHook(() => useJoinLobby(), { wrapper });
+
+    unmount();
+
+    expect(workshopState.observed).toBe(false);
+    expect(connectionState.observed).toBe(false);
+  });
+});
