+import { renderHook, act } from "@testing-library/react";
+import { Subject } from "rxjs";
+import { ConnectionState } from "../../domain/connectionState";
+import { Phase } from "../../domain/phases";
+import type { PhasedWorkshopState } from "../../domain/workshopState";
+import { useSessionState } from "../useSessionState";
+
+function fakePort() {
+  const workshopState = new Subject<PhasedWorkshopState>();
+  const connectionState = new Subject<ConnectionState>();
+
+  return {
+    port: { workshopState, connectionState },
+    workshopState,
+    connectionState,
+  };
+}
+
+describe("session state subscription", () => {
+  it("starts out connecting and without state", () => {
+    const { port } = fakePort();
+
+    const { result } = renderHook(() => useSessionState(port));
+
+    expect(result.current).toEqual({
+      workshopState: null,
+      connectionState: ConnectionState.Connecting,
+    });
+  });
+
+  it("keeps the latest workshop state the server pushes", () => {
+    const { port, workshopState } = fakePort();
+    const { result } = renderHook(() => useSessionState(port));
+
+    act(() => workshopState.next({ revision: 1, phase: Phase.Join }));
+    act(() => workshopState.next({ revision: 2, phase: Phase.Quiz }));
+
+    expect(result.current.workshopState).toEqual({
+      revision: 2,
+      phase: Phase.Quiz,
+    });
+  });
+
+  it("follows the connection state", () => {
+    const { port, connectionState } = fakePort();
+    const { result } = renderHook(() => useSessionState(port));
+
+    act(() => connectionState.next(ConnectionState.Reconnecting));
+
+    expect(result.current.connectionState).toBe(ConnectionState.Reconnecting);
+  });
+
+  it("resubscribes when the session is replaced", () => {
+    const first = fakePort();
+    const second = fakePort();
+    const { result, rerender } = renderHook(
+      ({ port }) => useSessionState(port),
+      {
+        initialProps: { port: first.port },
+      },
+    );
+
+    rerender({ port: second.port });
+
+    expect(first.workshopState.observed).toBe(false);
+    act(() => second.workshopState.next({ revision: 1, phase: Phase.Join }));
+    expect(result.current.workshopState).toEqual({
+      revision: 1,
+      phase: Phase.Join,
+    });
+  });
+
+  it("stops listening when the screen is left", () => {
+    const { port, workshopState, connectionState } = fakePort();
+    const { unmount } = renderHook(() => useSessionState(port));
+
+    unmount();
+
+    expect(workshopState.observed).toBe(false);
+    expect(connectionState.observed).toBe(false);
+  });
+});
