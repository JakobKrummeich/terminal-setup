+import { renderHook, act } from "@testing-library/react";
+import type { ReactNode } from "react";
+import { Subject } from "rxjs";
+import type { ConnectionState } from "../../../domain/connectionState";
+import { Phase } from "../../../domain/phases";
+import type { ParticipantWorkshopState } from "../../../domain/workshopState";
+import { ParticipantDependencyProvider } from "../dependencies";
+import { useParticipantHome } from "../useParticipantHome";
+
+function fakeSession() {
+  const workshopState = new Subject<ParticipantWorkshopState>();
+  const connectionState = new Subject<ConnectionState>();
+  const sessionState = { workshopState, connectionState };
+  const wrapper = ({ children }: { children: ReactNode }) => (
+    <ParticipantDependencyProvider dependencies={{ sessionState }}>
+      {children}
+    </ParticipantDependencyProvider>
+  );
+
+  return { wrapper, sessionState, workshopState };
+}
+
+describe("participant home logic", () => {
+  it("has no phase before the server pushed state", () => {
+    const { wrapper, sessionState } = fakeSession();
+
+    const { result } = renderHook(() => useParticipantHome(), { wrapper });
+
+    expect(result.current.phase).toBeNull();
+    expect(result.current.sessionState).toBe(sessionState);
+  });
+
+  it("follows the phase of the latest workshop state", () => {
+    const { wrapper, workshopState } = fakeSession();
+    const { result } = renderHook(() => useParticipantHome(), { wrapper });
+
+    act(() =>
+      workshopState.next({
+        revision: 1,
+        phase: Phase.Join,
+        participantCount: 2,
+      }),
+    );
+    expect(result.current.phase).toBe(Phase.Join);
+
+    act(() =>
+      workshopState.next({
+        revision: 2,
+        phase: Phase.SelectionResults,
+        participantCount: 2,
+        selection: { isOwnSubmitted: false, topValueIds: [] },
+      }),
+    );
+    expect(result.current.phase).toBe(Phase.SelectionResults);
+  });
+
+  it("stops listening when the screen is left", () => {
+    const { wrapper, workshopState } = fakeSession();
+    const { unmount } = renderHook(() => useParticipantHome(), { wrapper });
+
+    unmount();
+
+    expect(workshopState.observed).toBe(false);
+  });
+});
