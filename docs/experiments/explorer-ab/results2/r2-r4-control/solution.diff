+"use client";
+
+import styles from "./JoinLobby.module.css";
+import { useJoinLobby } from "./useJoinLobby";
+
+export function JoinLobby() {
+  const { isConnected, participantCountLabel } = useJoinLobby();
+
+  if (!isConnected) {
+    return (
+      <section className={styles.lobby}>
+        <p className={styles.notice}>Connecting to the workshop…</p>
+      </section>
+    );
+  }
+
+  return (
+    <section className={styles.lobby}>
+      <p className={styles.confirmation}>You’re in!</p>
+      <p className={styles.notice}>
+        Waiting for the facilitator to start the workshop…
+      </p>
+      {participantCountLabel !== null && (
+        <p className={styles.count}>{participantCountLabel}</p>
+      )}
+    </section>
+  );
+}
