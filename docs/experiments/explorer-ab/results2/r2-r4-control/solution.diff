+"use client";
+
+import { ConnectionState } from "../../../../domain/connectionState";
+import { useSessionState } from "../../../useSessionState";
+import { useParticipantDependencies } from "../../dependencies";
+
+export interface JoinLobbyResult {
+  isConnected: boolean;
+  participantCountLabel: string | null;
+}
+
+function participantCountLabelOf(participantCount: number | undefined) {
+  if (participantCount === undefined) {
+    return null;
+  }
+  return participantCount === 1
+    ? "1 participant"
+    : `${participantCount} participants`;
+}
+
+export function useJoinLobby(): JoinLobbyResult {
+  const { sessionState } = useParticipantDependencies();
+  const { workshopState, connectionState } = useSessionState(sessionState);
+
+  return {
+    isConnected: connectionState === ConnectionState.Connected,
+    participantCountLabel: participantCountLabelOf(
+      workshopState?.participantCount,
+    ),
+  };
+}
