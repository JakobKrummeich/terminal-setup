+"use client";
+
+import styles from "./JoinLobby.module.css";
+import { useJoinLobby } from "./useJoinLobby";
+
+export function JoinLobby() {
+  const { isConnected, participantCount } = useJoinLobby();
+
+  if (!isConnected) {
+    return (
+      <section className={styles.lobby} data-testid="lobby-connecting">
+        <p className={styles.connecting}>Connecting to the workshop&hellip;</p>
+      </section>
+    );
+  }
+
+  return (
+    <section className={styles.lobby} data-testid="lobby">
+      <h1 className={styles.heading}>You&apos;re in!</h1>
+      <p className={styles.waiting}>
+        Waiting for the facilitator to start the workshop&hellip;
+      </p>
+      <p className={styles.count} data-testid="participant-count">
+        {participantCount === 1
+          ? "1 participant"
+          : `${participantCount} participants`}
+      </p>
+    </section>
+  );
+}
