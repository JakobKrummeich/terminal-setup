+import { render, screen } from "@testing-library/react";
+import { JoinLobby } from "../JoinLobby";
+import { useJoinLobby } from "../useJoinLobby";
+
+jest.mock("../useJoinLobby", () => ({
+  useJoinLobby: jest.fn(),
+}));
+
+const lobby = useJoinLobby as jest.MockedFunction<typeof useJoinLobby>;
+
+describe("join lobby", () => {
+  it("welcomes the participant and shows how many have joined", () => {
+    lobby.mockReturnValue({ isConnected: true, participantCount: 12 });
+
+    render(<JoinLobby />);
+
+    screen.getByText("You're in!");
+    screen.getByText("Waiting for the facilitator to start the workshop", {
+      exact: false,
+    });
+    expect(screen.getByTestId("participant-count")).toHaveTextContent(
+      "12 participants",
+    );
+  });
+
+  it("counts a lone participant in the singular", () => {
+    lobby.mockReturnValue({ isConnected: true, participantCount: 1 });
+
+    render(<JoinLobby />);
+
+    expect(screen.getByTestId("participant-count")).toHaveTextContent(
+      "1 participant",
+    );
+  });
+
+  it("says it is still connecting while the connection is not established", () => {
+    lobby.mockReturnValue({ isConnected: false, participantCount: 4 });
+
+    render(<JoinLobby />);
+
+    screen.getByText("Connecting to the workshop", { exact: false });
+    expect(screen.queryByTestId("participant-count")).toBeNull();
+  });
+});
