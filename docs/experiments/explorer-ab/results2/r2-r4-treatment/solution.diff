@@ -0,0 +1,37 @@
+"use client";
+
+import { useEffect, useState } from "react";
+import { Subscription } from "rxjs";
+import { ConnectionState } from "../../../../domain/connectionState";
+import { useParticipantDependencies } from "../../dependencies";
+
+export interface JoinLobbyResult {
+  isConnected: boolean;
+  participantCount: number;
+}
+
+export function useJoinLobby(): JoinLobbyResult {
+  const { sessionState } = useParticipantDependencies();
+  const [isConnected, setConnected] = useState(false);
+  const [participantCount, setParticipantCount] = useState(0);
+
+  useEffect(() => {
+    const subscriptions = new Subscription();
+    subscriptions.add(
+      sessionState.connectionState.subscribe((connectionState) =>
+        setConnected(connectionState === ConnectionState.Connected),
+      ),
+    );
+    subscriptions.add(
+      sessionState.workshopState.subscribe((state) =>
+        setParticipantCount(state.participantCount),
+      ),
+    );
+
+    return () => {
+      subscriptions.unsubscribe();
+    };
+  }, [sessionState]);
+
+  return { isConnected, participantCount };
+}
