+"use client";
+
+import { useEffect, useState } from "react";
+import type { Phase } from "../../domain/phases";
+import { useParticipantDependencies } from "./dependencies";
+
+export interface ParticipantPhaseResult {
+  phase: Phase | null;
+}
+
+export function useParticipantPhase(): ParticipantPhaseResult {
+  const { sessionState } = useParticipantDependencies();
+  const [phase, setPhase] = useState<Phase | null>(null);
+
+  useEffect(() => {
+    const subscription = sessionState.workshopState.subscribe((state) =>
+      setPhase(state.phase),
+    );
+
+    return () => {
+      subscription.unsubscribe();
+    };
+  }, [sessionState]);
+
+  return { phase };
+}
