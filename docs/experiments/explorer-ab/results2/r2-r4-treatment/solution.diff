@@ -0,0 +1,67 @@
+import { renderHook, act } from "@testing-library/react";
+import { NEVER, Subject } from "rxjs";
+import { Phase } from "../../../domain/phases";
+import { QuizSubState } from "../../../domain/workshopState";
+import type { ParticipantWorkshopState } from "../../../domain/workshopState";
+import { useParticipantDependencies } from "../dependencies";
+import { useParticipantPhase } from "../useParticipantPhase";
+
+jest.mock("../dependencies", () => ({
+  useParticipantDependencies: jest.fn(),
+}));
+
+const dependencies = useParticipantDependencies as jest.MockedFunction<
+  typeof useParticipantDependencies
+>;
+
+function fakeSession() {
+  const workshopState = new Subject<ParticipantWorkshopState>();
+  dependencies.mockReturnValue({
+    sessionState: { workshopState, connectionState: NEVER },
+  });
+
+  return { workshopState };
+}
+
+describe("participant phase logic", () => {
+  it("knows no phase before the first workshop state", () => {
+    fakeSession();
+
+    const { result } = renderHook(() => useParticipantPhase());
+
+    expect(result.current.phase).toBeNull();
+  });
+
+  it("follows the phase of the latest workshop state", () => {
+    const { workshopState } = fakeSession();
+    const { result } = renderHook(() => useParticipantPhase());
+
+    act(() =>
+      workshopState.next({
+        revision: 1,
+        phase: Phase.Join,
+        participantCount: 2,
+      }),
+    );
+    expect(result.current.phase).toBe(Phase.Join);
+
+    act(() =>
+      workshopState.next({
+        revision: 2,
+        phase: Phase.Quiz,
+        participantCount: 2,
+        quiz: { questionIndex: 0, subState: QuizSubState.Answering },
+      }),
+    );
+    expect(result.current.phase).toBe(Phase.Quiz);
+  });
+
+  it("stops listening when the screen is left", () => {
+    const { workshopState } = fakeSession();
+    const { unmount } = renderHook(() => useParticipantPhase());
+
+    unmount();
+
+    expect(workshopState.observed).toBe(false);
+  });
+});
