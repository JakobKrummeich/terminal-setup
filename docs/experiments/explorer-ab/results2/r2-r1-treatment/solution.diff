diff --git a/backend/Application.Tests/FacilitatorQuizIntentTests.cs b/backend/Application.Tests/FacilitatorQuizIntentTests.cs
new file mode 100644
index 0000000..e2cb226
--- /dev/null
+++ b/backend/Application.Tests/FacilitatorQuizIntentTests.cs
@@ -0,0 +1,163 @@
+using ValuesWorkshop.Application.Intents;
+using ValuesWorkshop.Domain;
+
+namespace ValuesWorkshop.Application.Tests;
+
+public class FacilitatorQuizIntentTests
+{
+    private static readonly SessionIdentity KnownSession = new(
+        Guid.Parse("00000000-0000-0000-0000-00000000f00d")
+    );
+
+    private readonly RecordingBroadcaster broadcaster = new();
+
+    [Fact]
+    public async Task The_facilitator_poses_the_first_question()
+    {
+        var repository = FakeSessionRepository.Holding(SessionFixtures.InPhase(Phase.Quiz));
+
+        var result = await HandlerOver(repository)
+            .HandleAsync(new PoseNextQuestionCommand(KnownSession, TestSessions.FacilitatorCaller));
+
+        result.ShouldBe(IntentResult.Accepted());
+        repository.Saved.ShouldHaveSingleItem().Quiz.CurrentQuestionIndex.ShouldBe(0);
+        broadcaster.Broadcasts.ShouldHaveSingleItem().Quiz.CurrentQuestionIndex.ShouldBe(0);
+    }
+
+    [Fact]
+    public async Task The_facilitator_reveals_the_answer_of_the_current_question()
+    {
+        var repository = QuizAt(QuizProgress.Restore(2, false, false));
+
+        var result = await HandlerOver(repository)
+            .HandleAsync(new RevealAnswerCommand(KnownSession, TestSessions.FacilitatorCaller));
+
+        result.ShouldBe(IntentResult.Accepted());
+        repository.Saved.ShouldHaveSingleItem().Quiz.IsRevealed.ShouldBeTrue();
+    }
+
+    [Fact]
+    public async Task The_facilitator_shows_the_learning_text_after_the_reveal()
+    {
+        var repository = QuizAt(QuizProgress.Restore(2, true, false));
+
+        var result = await HandlerOver(repository)
+            .HandleAsync(new ShowLearningTextCommand(KnownSession, TestSessions.FacilitatorCaller));
+
+        result.ShouldBe(IntentResult.Accepted());
+        repository.Saved.ShouldHaveSingleItem().Quiz.IsLearningTextShown.ShouldBeTrue();
+    }
+
+    [Fact]
+    public async Task Moving_on_resets_the_reveal_and_the_learning_text()
+    {
+        var repository = QuizAt(QuizProgress.Restore(2, true, true));
+
+        await HandlerOver(repository)
+            .HandleAsync(new PoseNextQuestionCommand(KnownSession, TestSessions.FacilitatorCaller));
+
+        var saved = repository.Saved.ShouldHaveSingleItem();
+        saved.Quiz.CurrentQuestionIndex.ShouldBe(3);
+        saved.Quiz.IsRevealed.ShouldBeFalse();
+        saved.Quiz.IsLearningTextShown.ShouldBeFalse();
+    }
+
+    [Fact]
+    public async Task A_reveal_before_a_question_is_posed_is_rejected_as_a_wrong_phase()
+    {
+        var repository = QuizAt(QuizProgress.Restore(null, false, false));
+
+        var result = await HandlerOver(repository)
+            .HandleAsync(new RevealAnswerCommand(KnownSession, TestSessions.FacilitatorCaller));
+
+        await ShouldHaveChangedNothing(result, IntentRejectionCode.WrongPhase, repository);
+    }
+
+    [Fact]
+    public async Task A_learning_text_before_the_reveal_is_rejected_as_a_wrong_phase()
+    {
+        var repository = QuizAt(QuizProgress.Restore(2, false, false));
+
+        var result = await HandlerOver(repository)
+            .HandleAsync(new ShowLearningTextCommand(KnownSession, TestSessions.FacilitatorCaller));
+
+        await ShouldHaveChangedNothing(result, IntentRejectionCode.WrongPhase, repository);
+    }
+
+    [Fact]
+    public async Task Moving_on_before_the_learning_text_is_rejected_as_a_wrong_phase()
+    {
+        var repository = QuizAt(QuizProgress.Restore(2, true, false));
+
+        var result = await HandlerOver(repository)
+            .HandleAsync(new PoseNextQuestionCommand(KnownSession, TestSessions.FacilitatorCaller));
+
+        await ShouldHaveChangedNothing(result, IntentRejectionCode.WrongPhase, repository);
+    }
+
+    [Fact]
+    public async Task Driving_the_quiz_outside_the_quiz_phase_is_rejected_as_a_wrong_phase()
+    {
+        var repository = FakeSessionRepository.Holding(
+            SessionFixtures.InPhase(Phase.Join, revision: 7)
+        );
+
+        var result = await HandlerOver(repository)
+            .HandleAsync(new PoseNextQuestionCommand(KnownSession, TestSessions.FacilitatorCaller));
+
+        await ShouldHaveChangedNothing(result, IntentRejectionCode.WrongPhase, repository);
+    }
+
+    [Fact]
+    public async Task Another_subject_may_not_drive_the_quiz()
+    {
+        var repository = QuizAt(QuizProgress.Restore(2, false, false));
+
+        var result = await HandlerOver(repository)
+            .HandleAsync(new RevealAnswerCommand(KnownSession, new CallerSubject("someone-else")));
+
+        await ShouldHaveChangedNothing(result, IntentRejectionCode.NotAuthorized, repository);
+    }
+
+    [Fact]
+    public async Task Driving_the_quiz_of_an_unknown_session_is_rejected()
+    {
+        var repository = FakeSessionRepository.Empty();
+
+        var result = await HandlerOver(repository)
+            .HandleAsync(new RevealAnswerCommand(KnownSession, TestSessions.FacilitatorCaller));
+
+        result.Code.ShouldBe(IntentRejectionCode.UnknownSession);
+        repository.Saved.ShouldBeEmpty();
+        broadcaster.Broadcasts.ShouldBeEmpty();
+    }
+
+    private async Task ShouldHaveChangedNothing(
+        IntentResult result,
+        IntentRejectionCode expectedCode,
+        FakeSessionRepository repository
+    )
+    {
+        result.IsAccepted.ShouldBeFalse();
+        result.Code.ShouldBe(expectedCode);
+        result.Detail.ShouldNotBeNullOrWhiteSpace();
+        repository.Saved.ShouldBeEmpty();
+        broadcaster.Broadcasts.ShouldBeEmpty();
+        (await repository.LoadAsync(KnownSession)).ShouldNotBeNull().Revision.ShouldBe(7);
+    }
+
+    private static FakeSessionRepository QuizAt(QuizProgress quiz)
+    {
+        return FakeSessionRepository.Holding(
+            SessionFixtures.InPhase(Phase.Quiz, quiz, revision: 7)
+        );
+    }
+
+    private FacilitatorIntentHandler HandlerOver(FakeSessionRepository repository)
+    {
+        return new FacilitatorIntentHandler(
+            new IntentPipeline(new SessionCommandHandler(repository, broadcaster)),
+            new PhaseExitGuards(new GroupWorkExitGuard(), new FinalVotingExitGuard())
+        );
+    }
+}
