+
+    private void RequireQuizControl(CallerSubject caller)
+    {
+        if (!IsFacilitatedBy(caller))
+        {
+            throw new NotAuthorizedException(
+                "Only the facilitator of this session may drive the quiz (I2)."
+            );
+        }
+
+        if (PhaseProgress.CurrentPhase != Phase.Quiz)
+        {
+            throw new WrongPhaseException(
+                "The quiz is driven only while the workshop is in the quiz phase."
+            );
+        }
+    }
+
     public void BumpRevision()
     {
         Revision++;
