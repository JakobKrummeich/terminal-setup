@@ -0,0 +1,64 @@
+namespace ValuesWorkshop.Domain.Tests;
+
+public class SessionQuizControlTests
+{
+    private static readonly CallerSubject SomeoneElse = new("someone-else");
+
+    [Fact]
+    public void The_facilitator_walks_a_question_from_posing_to_the_learning_text()
+    {
+        var session = SessionInQuiz();
+
+        session.PoseNextQuestion(TestSessions.FacilitatorCaller);
+        session.RevealAnswer(TestSessions.FacilitatorCaller);
+        session.ShowLearningText(TestSessions.FacilitatorCaller);
+
+        session.Quiz.CurrentQuestionIndex.ShouldBe(0);
+        session.Quiz.IsRevealed.ShouldBeTrue();
+        session.Quiz.IsLearningTextShown.ShouldBeTrue();
+    }
+
+    [Fact]
+    public void Another_subject_may_not_drive_the_quiz()
+    {
+        var session = SessionInQuiz(QuizProgress.Restore(0, false, false));
+
+        Should.Throw<NotAuthorizedException>(() => session.PoseNextQuestion(SomeoneElse));
+        Should.Throw<NotAuthorizedException>(() => session.RevealAnswer(SomeoneElse));
+        Should.Throw<NotAuthorizedException>(() => session.ShowLearningText(SomeoneElse));
+
+        session.Quiz.CurrentQuestionIndex.ShouldBe(0);
+        session.Quiz.IsRevealed.ShouldBeFalse();
+    }
+
+    [Theory]
+    [InlineData(Phase.Join)]
+    [InlineData(Phase.ValueSelection)]
+    [InlineData(Phase.FinalPresentation)]
+    public void The_quiz_is_driven_only_while_the_workshop_is_in_the_quiz_phase(Phase phase)
+    {
+        var session = TestSessions.InPhase(
+            new SessionIdentity(Guid.NewGuid()),
+            phase,
+            QuizProgress.Restore(0, true, false)
+        );
+
+        Should.Throw<WrongPhaseException>(() =>
+            session.RevealAnswer(TestSessions.FacilitatorCaller)
+        );
+        Should.Throw<WrongPhaseException>(() =>
+            session.ShowLearningText(TestSessions.FacilitatorCaller)
+        );
+        Should.Throw<WrongPhaseException>(() =>
+            session.PoseNextQuestion(TestSessions.FacilitatorCaller)
+        );
+
+        session.Quiz.CurrentQuestionIndex.ShouldBe(0);
+        session.Quiz.IsLearningTextShown.ShouldBeFalse();
+    }
+
+    private static Session SessionInQuiz(QuizProgress? quiz = null)
+    {
+        return TestSessions.InPhase(new SessionIdentity(Guid.NewGuid()), Phase.Quiz, quiz);
+    }
+}
diff --git a/backend/Domain/QuizProgress.cs b/backend/Domain/QuizProgress.cs
index 7e5c3c7..3b811ea 100644
--- a/backend/Domain/QuizProgress.cs
+++ b/backend/Domain/QuizProgress.cs
@@ -11,6 +11,56 @@ public sealed class QuizProgress
         return CurrentQuestionIndex >= questionCount - 1 && IsRevealed && IsLearningTextShown;
     }
 
+    internal void RevealAnswer()
+    {
+        if (CurrentQuestionIndex is null)
+        {
+            throw new WrongPhaseException("An answer is revealed once a question is posed (T6).");
+        }
+
+        if (IsRevealed)
+        {
+            throw new WrongPhaseException(
+                "The current question's answer is already revealed (T6)."
+            );
+        }
+
+        IsRevealed = true;
+    }
+
+    internal void ShowLearningText()
+    {
+        if (!IsRevealed)
+        {
+            throw new WrongPhaseException(
+                "The learning text follows the reveal of the current question's answer (T7)."
+            );
+        }
+
+        if (IsLearningTextShown)
+        {
+            throw new WrongPhaseException(
+                "The current question's learning text is already shown (T7)."
+            );
+        }
+
+        IsLearningTextShown = true;
+    }
+
+    internal void PoseNextQuestion()
+    {
+        if (CurrentQuestionIndex is not null && !IsLearningTextShown)
+        {
+            throw new WrongPhaseException(
+                "The next question is posed once the current question's learning text was shown (T8)."
+            );
+        }
+
+        CurrentQuestionIndex = CurrentQuestionIndex is null ? 0 : CurrentQuestionIndex + 1;
+        IsRevealed = false;
+        IsLearningTextShown = false;
+    }
+
     internal static QuizProgress Restore(
         int? currentQuestionIndex,
         bool isRevealed,
