+    [Fact]
+    public void Joining_fills_the_roster_up_to_the_documented_maximum()
+    {
+        var session = TestSessions.Open(new SessionIdentity(Guid.NewGuid()));
+
+        FillRoster(session, Roster.MaximumParticipants - 1);
+        session.Join(Latecomer, Randomness.Fixed(0));
+
+        session.Roster.Participants.Count.ShouldBe(Roster.MaximumParticipants);
+        session.Roster.Participants.ShouldContain(Latecomer);
+    }
+
+    [Fact]
+    public void Joining_a_full_workshop_is_refused()
+    {
+        var session = TestSessions.Open(new SessionIdentity(Guid.NewGuid()));
+        FillRoster(session, Roster.MaximumParticipants);
+
+        Should.Throw<InvariantViolationException>(() =>
+            session.Join(Latecomer, Randomness.Fixed(0))
+        );
+
+        session.Roster.Participants.Count.ShouldBe(Roster.MaximumParticipants);
+        session.Roster.Participants.ShouldNotContain(Latecomer);
+    }
+
+    [Fact]
+    public void Reconnecting_to_a_full_workshop_resumes_the_existing_place()
+    {
+        var session = TestSessions.Open(new SessionIdentity(Guid.NewGuid()));
+        FillRoster(session, Roster.MaximumParticipants - 1);
+        session.Join(Latecomer, Randomness.Fixed(0));
+
+        var joined = session.Join(Latecomer, Randomness.Fixed(0));
+
+        joined.ShouldBeFalse();
+        session.Roster.Participants.Count.ShouldBe(Roster.MaximumParticipants);
+    }
+
