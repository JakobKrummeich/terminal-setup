diff --git a/backend/Domain.Tests/SessionQuizControlTests.cs b/backend/Domain.Tests/SessionQuizControlTests.cs
new file mode 100644
index 0000000..abb6d95
--- /dev/null
+++ b/backend/Domain.Tests/SessionQuizControlTests.cs
@@ -0,0 +1,113 @@
+namespace ValuesWorkshop.Domain.Tests;
+
+public class SessionQuizControlTests
+{
+    private static readonly CallerSubject Stranger = new("someone-else");
+
+    [Fact]
+    public void The_facilitator_walks_the_current_question_forward()
+    {
+        var session = InQuiz();
+
+        session.PoseNextQuizQuestion(TestSessions.CallerOf(session));
+        session.RevealQuizAnswer(TestSessions.CallerOf(session));
+        session.ShowQuizLearningText(TestSessions.CallerOf(session));
+
+        session.Quiz.CurrentQuestionIndex.ShouldBe(0);
+        session.Quiz.IsRevealed.ShouldBeTrue();
+        session.Quiz.IsLearningTextShown.ShouldBeTrue();
+    }
+
+    [Fact]
+    public void Posing_the_next_question_as_someone_other_than_the_facilitator_is_refused()
+    {
+        var session = InQuiz(Revealed());
+
+        Should.Throw<NotAuthorizedException>(() => session.PoseNextQuizQuestion(Stranger));
+
+        ShouldStillBeRevealed(session);
+    }
+
+    [Fact]
+    public void Revealing_the_answer_as_someone_other_than_the_facilitator_is_refused()
+    {
+        var session = InQuiz(Posed());
+
+        Should.Throw<NotAuthorizedException>(() => session.RevealQuizAnswer(Stranger));
+
+        session.Quiz.IsRevealed.ShouldBeFalse();
+    }
+
+    [Fact]
+    public void Showing_the_learning_text_as_someone_other_than_the_facilitator_is_refused()
+    {
+        var session = InQuiz(Revealed());
+
+        Should.Throw<NotAuthorizedException>(() => session.ShowQuizLearningText(Stranger));
+
+        ShouldStillBeRevealed(session);
+    }
+
+    [Fact]
+    public void Posing_the_next_question_outside_the_quiz_phase_is_refused()
+    {
+        var session = InPhase(Phase.ValueSelection, Revealed());
+
+        Should.Throw<WrongPhaseException>(() =>
+            session.PoseNextQuizQuestion(TestSessions.CallerOf(session))
+        );
+
+        ShouldStillBeRevealed(session);
+    }
+
+    [Fact]
+    public void Revealing_the_answer_outside_the_quiz_phase_is_refused()
+    {
+        var session = InPhase(Phase.Join, Posed());
+
+        Should.Throw<WrongPhaseException>(() =>
+            session.RevealQuizAnswer(TestSessions.CallerOf(session))
+        );
+
+        session.Quiz.IsRevealed.ShouldBeFalse();
+    }
+
+    [Fact]
+    public void Showing_the_learning_text_outside_the_quiz_phase_is_refused()
+    {
+        var session = InPhase(Phase.ValueSelection, Revealed());
+
+        Should.Throw<WrongPhaseException>(() =>
+            session.ShowQuizLearningText(TestSessions.CallerOf(session))
+        );
+
+        ShouldStillBeRevealed(session);
+    }
+
+    private static QuizProgress Posed()
+    {
+        return QuizProgress.Restore(0, false, false);
+    }
+
+    private static QuizProgress Revealed()
+    {
+        return QuizProgress.Restore(0, true, false);
+    }
+
+    private static void ShouldStillBeRevealed(Session session)
+    {
+        session.Quiz.CurrentQuestionIndex.ShouldBe(0);
+        session.Quiz.IsRevealed.ShouldBeTrue();
+        session.Quiz.IsLearningTextShown.ShouldBeFalse();
+    }
+
+    private static Session InQuiz(QuizProgress? quiz = null)
+    {
+        return InPhase(Phase.Quiz, quiz);
+    }
+
+    private static Session InPhase(Phase phase, QuizProgress? quiz)
+    {
+        return TestSessions.InPhase(new SessionIdentity(Guid.NewGuid()), phase, quiz);
+    }
+}
diff --git a/backend/Domain/QuizProgress.cs b/backend/Domain/QuizProgress.cs
