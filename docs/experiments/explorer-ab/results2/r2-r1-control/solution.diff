         return CurrentQuestionIndex >= questionCount - 1 && IsRevealed && IsLearningTextShown;
     }
 
+    internal void RevealAnswer()
+    {
+        if (CurrentQuestionIndex is null)
+        {
+            throw new WrongPhaseException(
+                "An answer is revealed only once a question has been posed."
+            );
+        }
+
+        if (IsRevealed)
+        {
+            throw new WrongPhaseException(
+                "The answer to the current question is already revealed."
+            );
+        }
+
+        IsRevealed = true;
+    }
+
+    internal void ShowLearningText()
+    {
+        if (!IsRevealed)
+        {
+            throw new WrongPhaseException(
+                "The learning text follows the revealed answer of the current question."
+            );
+        }
+
+        if (IsLearningTextShown)
+        {
+            throw new WrongPhaseException(
+                "The learning text of the current question is already shown."
+            );
+        }
+
+        IsLearningTextShown = true;
+    }
+
+    internal void PoseNextQuestion()
+    {
+        if (CurrentQuestionIndex is not null && !IsLearningTextShown)
+        {
+            throw new WrongPhaseException(
+                "The next question follows the current question's learning text."
+            );
+        }
+
+        CurrentQuestionIndex = CurrentQuestionIndex + 1 ?? 0;
+        IsRevealed = false;
+        IsLearningTextShown = false;
+    }
