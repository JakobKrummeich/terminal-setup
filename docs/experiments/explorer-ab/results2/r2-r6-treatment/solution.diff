diff --git a/frontend/src/app/presenter/__tests__/usePresenterHome.test.ts b/frontend/src/app/presenter/__tests__/usePresenterHome.test.ts
new file mode 100644
index 0000000..1662f60
--- /dev/null
+++ b/frontend/src/app/presenter/__tests__/usePresenterHome.test.ts
@@ -0,0 +1,51 @@
+import { renderHook, act } from "@testing-library/react";
+import { NEVER, Subject } from "rxjs";
+import { Phase } from "../../../domain/phases";
+import type { PresenterWorkshopState } from "../../../domain/workshopState";
+import { usePresenterHome } from "../usePresenterHome";
+
+function fakePort() {
+  const workshopState = new Subject<PresenterWorkshopState>();
+
+  return {
+    port: { workshopState, connectionState: NEVER },
+    workshopState,
+  };
+}
+
+function joinState(sessionName: string): PresenterWorkshopState {
+  return {
+    revision: 1,
+    phase: Phase.Join,
+    sessionName,
+    participantCount: 0,
+  };
+}
+
+describe("presenter home logic", () => {
+  it("has no session name until the first state arrives", () => {
+    const { port } = fakePort();
+
+    const { result } = renderHook(() => usePresenterHome(port));
+
+    expect(result.current.sessionName).toBeNull();
+  });
+
+  it("follows the session name of the latest workshop state", () => {
+    const { port, workshopState } = fakePort();
+    const { result } = renderHook(() => usePresenterHome(port));
+
+    act(() => workshopState.next(joinState("Monday workshop")));
+
+    expect(result.current.sessionName).toBe("Monday workshop");
+  });
+
+  it("stops listening when the screen is left", () => {
+    const { port, workshopState } = fakePort();
+    const { unmount } = renderHook(() => usePresenterHome(port));
+
+    unmount();
+
+    expect(workshopState.observed).toBe(false);
+  });
+});
