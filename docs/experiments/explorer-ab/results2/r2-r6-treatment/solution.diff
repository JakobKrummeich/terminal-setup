diff --git a/frontend/src/app/presenter/usePresenterHome.ts b/frontend/src/app/presenter/usePresenterHome.ts
new file mode 100644
index 0000000..ef3f101
--- /dev/null
+++ b/frontend/src/app/presenter/usePresenterHome.ts
@@ -0,0 +1,26 @@
+"use client";
+
+import { useEffect, useState } from "react";
+import type { PresenterSessionStatePort } from "../../domain/ports/presenter/sessionStatePort";
+
+export interface PresenterHomeResult {
+  sessionName: string | null;
+}
+
+export function usePresenterHome(
+  sessionState: PresenterSessionStatePort,
+): PresenterHomeResult {
+  const [sessionName, setSessionName] = useState<string | null>(null);
+
+  useEffect(() => {
+    const subscription = sessionState.workshopState.subscribe((state) =>
+      setSessionName(state.sessionName),
+    );
+
+    return () => {
+      subscription.unsubscribe();
+    };
+  }, [sessionState]);
+
+  return { sessionName };
+}
