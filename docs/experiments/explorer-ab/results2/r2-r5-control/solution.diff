diff --git a/frontend/src/app/facilitator/__tests__/useParticipantRoster.test.ts b/frontend/src/app/facilitator/__tests__/useParticipantRoster.test.ts
new file mode 100644
index 0000000..dc0d193
--- /dev/null
+++ b/frontend/src/app/facilitator/__tests__/useParticipantRoster.test.ts
@@ -0,0 +1,96 @@
+import { renderHook, act } from "@testing-library/react";
+import { EMPTY, NEVER, Subject } from "rxjs";
+import { Phase } from "../../../domain/phases";
+import type { FacilitatorWorkshopState } from "../../../domain/workshopState";
+import { useFacilitatorDependencies } from "../dependencies";
+import { useParticipantRoster } from "../useParticipantRoster";
+
+jest.mock("../dependencies", () => ({
+  useFacilitatorDependencies: jest.fn(),
+}));
+
+const dependencies = useFacilitatorDependencies as jest.MockedFunction<
+  typeof useFacilitatorDependencies
+>;
+
+function joinState(participantIds: string[]): FacilitatorWorkshopState {
+  return {
+    revision: participantIds.length,
+    phase: Phase.Join,
+    roster: { participantIds, participantCount: participantIds.length },
+  };
+}
+
+function withWorkshopState(
+  workshopState: Subject<FacilitatorWorkshopState> | typeof NEVER,
+) {
+  dependencies.mockReturnValue({
+    sessionState: { workshopState, connectionState: NEVER },
+    lifecycle: { advancePhase: () => EMPTY },
+  });
+}
+
+describe("participant roster logic", () => {
+  it("reports an empty roster before any state is pushed", () => {
+    withWorkshopState(NEVER);
+
+    const { result } = renderHook(() => useParticipantRoster());
+
+    expect(result.current).toEqual({
+      participantCount: 0,
+      participantIds: [],
+    });
+  });
+
+  it("takes the roster from the pushed state", () => {
+    const workshopState = new Subject<FacilitatorWorkshopState>();
+    withWorkshopState(workshopState);
+    const { result } = renderHook(() => useParticipantRoster());
+
+    act(() => workshopState.next(joinState(["ada", "grace"])));
+
+    expect(result.current).toEqual({
+      participantCount: 2,
+      participantIds: ["ada", "grace"],
+    });
+  });
+
+  it("stays in sync with later pushes", () => {
+    const workshopState = new Subject<FacilitatorWorkshopState>();
+    withWorkshopState(workshopState);
+    const { result } = renderHook(() => useParticipantRoster());
+
+    act(() => workshopState.next(joinState(["ada"])));
+    act(() => workshopState.next(joinState(["ada", "grace", "alan"])));
+
+    expect(result.current.participantCount).toBe(3);
+    expect(result.current.participantIds).toEqual(["ada", "grace", "alan"]);
+  });
+
+  it("keeps the roster of a later phase", () => {
+    const workshopState = new Subject<FacilitatorWorkshopState>();
+    withWorkshopState(workshopState);
+    const { result } = renderHook(() => useParticipantRoster());
+
+    act(() =>
+      workshopState.next({
+        revision: 9,
+        phase: Phase.GroupWork,
+        roster: { participantIds: ["ada"], participantCount: 1 },
+        groups: [],
+      }),
+    );
+
+    expect(result.current.participantIds).toEqual(["ada"]);
+  });
+
+  it("stops listening when the screen is left", () => {
+    const workshopState = new Subject<FacilitatorWorkshopState>();
+    withWorkshopState(workshopState);
+    const { unmount } = renderHook(() => useParticipantRoster());
+
+    unmount();
+
+    expect(workshopState.observed).toBe(false);
+  });
+});
