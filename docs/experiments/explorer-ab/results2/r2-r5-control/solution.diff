+"use client";
+
+import styles from "./ParticipantRoster.module.css";
+import { useParticipantRoster } from "./useParticipantRoster";
+
+export function ParticipantRoster() {
+  const { participantCount, participantIds } = useParticipantRoster();
+
+  return (
+    <section className={styles.panel} aria-label="Participants">
+      <h2 className={styles.heading}>
+        Participants
+        <span className={styles.count} data-testid="participant-count">
+          {participantCount}
+        </span>
+      </h2>
+      {participantIds.length === 0 ? (
+        <p className={styles.empty}>No participants have joined yet</p>
+      ) : (
+        <ul className={styles.list}>
+          {participantIds.map((participantId) => (
+            <li key={participantId} className={styles.participant}>
+              {participantId}
+            </li>
+          ))}
+        </ul>
+      )}
+    </section>
+  );
+}
