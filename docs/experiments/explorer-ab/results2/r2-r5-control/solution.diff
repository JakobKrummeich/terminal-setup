diff --git a/frontend/src/app/facilitator/useParticipantRoster.ts b/frontend/src/app/facilitator/useParticipantRoster.ts
new file mode 100644
index 0000000..848b4dc
--- /dev/null
+++ b/frontend/src/app/facilitator/useParticipantRoster.ts
@@ -0,0 +1,31 @@
+"use client";
+
+import { useEffect, useState } from "react";
+import { useFacilitatorDependencies } from "./dependencies";
+
+export interface ParticipantRosterResult {
+  participantCount: number;
+  participantIds: readonly string[];
+}
+
+const noParticipants: ParticipantRosterResult = {
+  participantCount: 0,
+  participantIds: [],
+};
+
+export function useParticipantRoster(): ParticipantRosterResult {
+  const { sessionState } = useFacilitatorDependencies();
+  const [roster, setRoster] = useState<ParticipantRosterResult>(noParticipants);
+
+  useEffect(() => {
+    const subscription = sessionState.workshopState.subscribe((state) =>
+      setRoster(state.roster),
+    );
+
+    return () => {
+      subscription.unsubscribe();
+    };
+  }, [sessionState]);
+
+  return roster;
+}
