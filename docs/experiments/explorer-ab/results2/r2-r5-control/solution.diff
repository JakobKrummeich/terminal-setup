+import { render, screen } from "@testing-library/react";
+import { ParticipantRoster } from "../ParticipantRoster";
+import { useParticipantRoster } from "../useParticipantRoster";
+
+jest.mock("../useParticipantRoster", () => ({
+  useParticipantRoster: jest.fn(),
+}));
+
+const roster = useParticipantRoster as jest.MockedFunction<
+  typeof useParticipantRoster
+>;
+
+describe("participant roster", () => {
+  it("shows an explicit empty state before anyone joins", () => {
+    roster.mockReturnValue({ participantCount: 0, participantIds: [] });
+
+    render(<ParticipantRoster />);
+
+    expect(screen.getByTestId("participant-count")).toHaveTextContent("0");
+    screen.getByText("No participants have joined yet");
+    expect(screen.queryByRole("list")).not.toBeInTheDocument();
+  });
+
+  it("shows the count and every joined participant", () => {
+    roster.mockReturnValue({
+      participantCount: 2,
+      participantIds: ["ada", "grace"],
+    });
+
+    render(<ParticipantRoster />);
+
+    expect(screen.getByTestId("participant-count")).toHaveTextContent("2");
+    expect(
+      screen.getAllByRole("listitem").map((item) => item.textContent),
+    ).toEqual(["ada", "grace"]);
+    expect(
+      screen.queryByText("No participants have joined yet"),
+    ).not.toBeInTheDocument();
+  });
+
+  it("renders a long identifier as its own entry", () => {
+    const longIdentifier = "participant-".repeat(12);
+    roster.mockReturnValue({
+      participantCount: 1,
+      participantIds: [longIdentifier],
+    });
+
+    render(<ParticipantRoster />);
+
+    screen.getByText(longIdentifier);
+  });
+});
