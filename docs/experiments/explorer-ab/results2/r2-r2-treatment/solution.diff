+    [Fact]
+    public void A_session_below_its_capacity_still_accepts_a_new_participant()
+    {
+        var session = SessionWithRoster(ParticipantsNumbered(29));
+
+        session.Join(Latecomer, Randomness.Fixed(0));
+
+        session.Roster.Participants.Count.ShouldBe(30);
+    }
+
+    [Fact]
+    public void A_full_session_refuses_a_new_participant()
+    {
+        var session = SessionWithRoster(ParticipantsNumbered(30));
+
+        var violation = Should.Throw<InvariantViolationException>(() =>
+            session.Join(Latecomer, Randomness.Fixed(0))
+        );
+
+        violation.Message.ShouldContain("30");
+        session.Roster.Participants.Count.ShouldBe(30);
+    }
+
+    [Fact]
+    public void A_participant_of_a_full_session_still_resumes_their_existing_place()
+    {
+        var participants = ParticipantsNumbered(30);
+        var session = SessionWithRoster(participants);
+
+        var joined = session.Join(participants[^1], Randomness.Fixed(0));
+
+        joined.ShouldBeFalse();
+        session.Roster.Participants.Count.ShouldBe(30);
+    }
+
+    private static IReadOnlyList<ParticipantId> ParticipantsNumbered(int count)
+    {
+        return Enumerable
+            .Range(1, count)
+            .Select(number => new ParticipantId(
+                Guid.Parse($"00000000-0000-0000-0000-{number:000000000000}")
+            ))
+            .ToList();
+    }
+
+    private static Session SessionWithRoster(IReadOnlyList<ParticipantId> participants)
+    {
+        return Session.Restore(
+            new SessionIdentity(Guid.NewGuid()),
+            TestSessions.Facilitator,
+            TestSessions.Name,
+            Roster.Restore(participants),
+            PhaseProgress.Restore(Phase.Join),
+            QuizProgress.Restore(null, false, false),
+            SelectionRound.Restore([], []),
+            new FormationRecord(),
+            PresentationWalk.Restore(null, null, 0),
+            VotingRounds.Restore(false, 0, []),
+            revision: 0
+        );
+    }
+
     private static Group GroupNamed(Session session, string name)
     {
         return session.Formation.Groups.Single(group => group.Name == name);
