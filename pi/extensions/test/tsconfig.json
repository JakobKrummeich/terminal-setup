{
	// Typecheck config for the extensions under test. The bare imports used by
	// the extensions only resolve through the node_modules symlink farm that
	// farm.sh builds next to this file. Run it via ./check.sh (pinned tsc from
	// tools/, builds the farm itself) — never a bare `tsc` (stub on PATH).
	"compilerOptions": {
		"noEmit": true,
		"strict": true,
		"target": "es2022",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"types": ["node"],
		"typeRoots": ["./node_modules/@types"],
		// WHY: an accidental same-name method in a pi subclass silently replaces pi's;
		// `override` makes that an explicit, reviewable choice.
		"noImplicitOverride": true,
		// WHY: unintended fallthrough is a silent control-flow bug; intentional ones
		// must be written as grouped empty cases.
		"noFallthroughCasesInSwitch": true,
		// WHY: run.sh executes the sources with Node's type stripping (no transform),
		// which cannot run enums/namespaces/parameter properties — pi's jiti loader
		// can, so without this flag such syntax would pass pi and break the tests.
		"erasableSyntaxOnly": true,

		"paths": {
			"@earendil-works/pi-coding-agent": ["./node_modules/@earendil-works/pi-coding-agent/dist/index.d.ts"],
			"@earendil-works/pi-ai": ["./node_modules/@earendil-works/pi-ai/dist/index.d.ts"],
			"@earendil-works/pi-ai/compat": ["./node_modules/@earendil-works/pi-ai/dist/compat.d.ts"],
			"@earendil-works/pi-tui": ["./node_modules/@earendil-works/pi-tui/dist/index.d.ts"],
			"typebox": ["./node_modules/typebox/build/index.d.mts"]
		}
	},
	"include": [
		"./*.ts",
		"../*.ts",
		"../lib/*.ts"
	]
}
